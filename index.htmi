
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>ردیاب GPS من</title>
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
  <style>
    body {
      font-family: Tahoma, sans-serif;
      margin: 0;
      background: #f2f4f7;
      color: #222;
    }
    header {
      background: #172554;
      color: white;
      padding: 18px;
      text-align: center;
    }
    #status {
      background: white;
      margin: 12px;
      padding: 14px;
      border-radius: 10px;
    }
    #map {
      height: 65vh;
      min-height: 350px;
      margin: 12px;
      border-radius: 10px;
    }
  </style>
</head>
<body>
  <header>
    <h2>ردیاب GPS من</h2>
    <div>سامانهٔ نمایش موقعیت خودرو</div>
  </header>

  <div id="status">هنوز مختصات ردیاب دریافت نشده است.</div>
  <div id="map"></div>

  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script>
    const map = L.map('map').setView([32.4279, 53.6880], 5);

    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 19,
      attribution: '&copy; OpenStreetMap'
    }).addTo(map);

    document.getElementById('status').textContent =
      'نقشه آماده است؛ هنوز ردیاب به سرور متصل نشده است.';
  </script>
</body>
</html>
